# Copia este archivo como ".env" y rellena los valores.
# NUNCA subas el archivo .env a GitHub.

# Discord Developer Portal → tu app → Bot → Reset Token
DISCORD_TOKEN=

# Discord Developer Portal → tu app → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=

# Neon → tu proyecto → Connection string
DATABASE_URL=

# Opcional: ID de tu servidor de Discord (0 = todos los servidores)
# GUILD_ID=1036557219585589319
